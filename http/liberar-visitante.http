# Fluxo: liberar a entrada de um visitante (exige confirmação)
@host = http://localhost:8000
# _get_session usa user_id "101" fixo, então use o apartamento 101
@apartamento = 101
@session_id = {{criarSessao.response.body.session_id}}
@confirmacao_id = {{pedirVisitante.response.body.confirmacoes_pendentes[0].id}}

### 1. Criar sessão
# @name criarSessao
POST {{host}}/sessoes/
Content-Type: application/json

{
    "apartamento": "{{apartamento}}"
}

### 2. Pedir a liberação
# @name pedirVisitante
POST {{host}}/sessoes/{{session_id}}/mensagens
Content-Type: application/json

{
    "texto": "Libere a entrada do visitante Carlos Silva"
}

### 3. Confirmar a liberação (use o id da confirmação retornado no passo 2)
POST {{host}}/sessoes/{{session_id}}/confirmacoes
Content-Type: application/json

{
    "id": "{{confirmacao_id}}",
    "confirmado": true
}

### 3b. Ou recusar
POST {{host}}/sessoes/{{session_id}}/confirmacoes
Content-Type: application/json

{
    "id": "{{confirmacao_id}}",
    "confirmado": false
}

### 4. Conferir os visitantes
GET {{host}}/apartamentos/{{apartamento}}/visitantes
