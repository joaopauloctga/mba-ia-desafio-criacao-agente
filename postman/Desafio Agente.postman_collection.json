					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/apartamentos/{{apartamento}}/reservas",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"apartamentos",
								"{{apartamento}}",
								"reservas"
							]
						},
						"description": "Lista as reservas cadastradas para o apartamento informado."
					},
					"response": []
				},
				{
					"name": "Listar Visitantes do Apartamento",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/apartamentos/{{apartamento}}/visitantes",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"apartamentos",
								"{{apartamento}}",
								"visitantes"
							]
						},
						"description": "Lista os visitantes cadastrados para o apartamento informado."
					},
					"response": []
				}
			]
		},
		{
			"name": "Health Check",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/health",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"health"
					]
				},
				"description": "Verifica se a API está no ar."
			},
			"response": []
		}
	]
}
